# Скопируйте в .env (в git не попадает). Всё необязательно: без .env работает режим лаунчера.

# desktop — один компьютер, SQLite, только 127.0.0.1; server — общий сервер за HTTPS
# ORCHESTRA_MODE=desktop
# ORCHESTRA_PORT=8710
# ORCHESTRA_DATA_DIR=C:\Users\me\AppData\Local\Orchestra\AI

# Сервер: PostgreSQL и публичный адрес (для HSTS, Secure-cookie, проверки Origin)
# ORCHESTRA_DATABASE_URL=postgresql+asyncpg://orchestra:пароль@localhost:5432/orchestra
# ORCHESTRA_PUBLIC_URL=https://ai.example.com

# Мастер-ключ хранилища секретов (base64, 32 байта). Пусто — data/master.key под DPAPI
# ORCHESTRA_MASTER_KEY=
# ORCHESTRA_MASTER_KEY_FILE=

# Инструмент «Чтение сайта»: разрешённые домены через запятую (пусто — выключен)
# ORCHESTRA_FETCH_ALLOWLIST=example.com,docs.cntd.ru,zakupki.gov.ru
