# Скопируйте в deploy/.env (в git не попадает) и заполните.
ORCHESTRA_DOMAIN=ai.example.com
# Пароль PostgreSQL: длинная случайная строка
DB_PASSWORD=
# Разовый токен первичной настройки; после создания владельца можно удалить
ORCHESTRA_SETUP_TOKEN=
# Вход только из сетей компании (CIDR через запятую): офис и VPN. Пусто — откуда угодно
ORCHESTRA_ALLOWED_NETWORKS=
# Откуда принимать входящие вебхуки (например, адреса Битрикс24). Пусто — откуда угодно (события подписаны)
ORCHESTRA_HOOK_NETWORKS=
